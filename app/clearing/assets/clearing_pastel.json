{
  "version": 8,
  "name": "Clearing Pastel",
  "metadata": {
    "maputnik:renderer": "mbgljs"
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "© OpenStreetMap contributors · OpenFreeMap"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#F6F1E7" }
    },
    {
      "id": "residential-land",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["==", ["get", "class"], "residential"],
      "paint": { "fill-color": "#F3E9DC", "fill-opacity": 0.68 }
    },
    {
      "id": "green-spaces",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["match", ["get", "class"], ["park", "garden", "pitch", "cemetery"], true, false],
      "paint": { "fill-color": "#B7DFA7", "fill-opacity": 0.9 }
    },
    {
      "id": "woodland",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["match", ["get", "class"], ["wood", "forest"], true, false],
      "paint": { "fill-color": "#A8D39A", "fill-opacity": 0.8 }
    },
    {
      "id": "grassland",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["match", ["get", "class"], ["grass", "meadow"], true, false],
      "paint": { "fill-color": "#C8E5AE", "fill-opacity": 0.8 }
    },
    {
      "id": "scrub-and-orchards",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["match", ["get", "class"], ["scrub", "orchard"], true, false],
      "paint": { "fill-color": "#D9E5AF", "fill-opacity": 0.78 }
    },
    {
      "id": "farmland",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "farmland"],
      "paint": { "fill-color": "#EEE7B8", "fill-opacity": 0.66 }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": { "fill-color": "#9ED3EA" }
    },
    {
      "id": "waterways",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#88C9E4",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 14, 1.5, 19, 5]
      }
    },
    {
      "id": "major-road-casings",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#D8BFAF",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.8, 10, 1.8, 14, 4.2, 19, 12]
      }
    },
    {
      "id": "local-road-casings",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary"], false, true],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#D7D0C3",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.35, 14, 1.1, 19, 3.5]
      }
    },
    {
      "id": "major-roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": ["match", ["get", "class"], "motorway", "#E9A78F", "trunk", "#EDB49B", "primary", "#F0C2A7", "secondary", "#F3D2B7", "#F5DDC8"],
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.45, 10, 1.05, 14, 2.9, 19, 9]
      }
    },
    {
      "id": "local-roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary"], false, true],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": ["match", ["get", "class"], "path", "#D2B7D8", "pedestrian", "#D6C3DC", "track", "#C8C99F", "#FFFEFA"],
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.18, 14, 0.65, 19, 2.3]
      }
    }
  ]
}
